# Copy this file to .env.local (for local dev) or add these as GitHub repository
# "Actions variables" (Settings → Secrets and variables → Actions → Variables) for deploys.
# Leave VITE_FIREBASE_API_KEY empty to run in demo mode (data stays in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional: only allow Google accounts from this domain to sign in
VITE_ALLOWED_DOMAIN=
# Optional: comma-separated emails allowed to pick the Teacher role (empty = anyone)
VITE_TEACHER_EMAILS=
